{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blink-hunters",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "jupyter",
      "runtimeExecutable": ".venv/bin/jupyter",
      "runtimeArgs": ["lab", "--no-browser", "--ip=127.0.0.1", "--port=8888", "--ServerApp.token=", "--ServerApp.password=", "--notebook-dir=."],
      "port": 8888
    }
  ]
}
